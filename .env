API_URL=https://example.com/api      # The API endpoint to test
API_METHOD=GET                       # HTTP method (GET, POST, etc.)
API_CONCURRENCY=50                   # Number of concurrent requests
API_TOTAL_REQUESTS=100               # Total number of requests to send
API_HEADERS={"Content-Type": "application/json"}  # Request headers as JSON
API_BODY=                            # Request body (leave empty for GET requests)
TIME_OUT=10                           # timeout of the request in second
